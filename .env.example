# Environment Variables for csvlasik

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Google Translation Services
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id

# Optional: DeepL Translation (for future implementation)
# DEEPL_API_KEY=your-deepl-api-key-here
# DEEPL_API_URL=https://api-free.deepl.com/v2

# Application Settings
VITE_APP_NAME=ClearSight
VITE_DEFAULT_LANGUAGE=en
VITE_FALLBACK_LANGUAGE=en

# Contact Information
VITE_PHONE_NUMBER=(844) 211-5462
VITE_EMAIL=info@clearsight-la.com
VITE_ADDRESS="3650 Martin Luther King Jr Blvd, Lakewood, CA 90712"

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/clearsightla
VITE_INSTAGRAM_URL=https://instagram.com/clearsightla
VITE_YOUTUBE_URL=https://youtube.com/clearsightla
VITE_TWITTER_URL=https://twitter.com/clearsightla
VITE_TIKTOK_URL=https://tiktok.com/@clearsightla

# Google Analytics (optional)
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Appointment Scheduling API (optional)
# VITE_APPOINTMENT_API_URL=https://api.appointment-system.com
# VITE_APPOINTMENT_API_KEY=your-appointment-api-key

# Feature Flags
VITE_ENABLE_CHAT=false
VITE_ENABLE_ONLINE_BOOKING=true
VITE_ENABLE_FINANCING_CALCULATOR=true
VITE_ENABLE_VIRTUAL_CONSULTATION=false

# Development Settings
VITE_DEBUG_TRANSLATIONS=false