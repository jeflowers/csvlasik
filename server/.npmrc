# Reduce deprecation warnings and noise
audit-level=moderate
fund=false
progress=false
loglevel=error  # Only show errors, not warnings

# Package resolution - more flexible for server
legacy-peer-deps=true  # Changed to true - prevents peer dep conflicts
strict-peer-deps=false
auto-install-peers=true  # Auto-install peer dependencies

# Timeout settings
timeout=60000
fetch-timeout=60000
fetch-retries=2  # Add retry logic

# Registry settings
registry=https://registry.npmjs.org/

# Cache settings (cache-max is deprecated)
prefer-online=true  # Replace deprecated cache-max
cache-min=3600  # Cache for 1 hour minimum

# Server-specific settings
save-exact=false  # Use ^ for flexibility
package-lock=true  # Ensure lock file is created
engine-strict=false  # Don't fail on engine mismatches