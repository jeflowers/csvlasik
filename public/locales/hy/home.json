    "eyebrow": "\u0540\u0561\u0575\u057f\u0576\u0561\u0562\u0565\u0580\u0568",
    "title": "\u0534\u0580. \u0549\u0561\u0580\u056c\u0566 \u0556\u056c\u0561\u0578\u0582\u0565\u0580\u057d",
    "paragraph1": "\u0534\u0580. \u0556\u056c\u0561\u0578\u0582\u0565\u0580\u057d\u0568 \u056b\u0580\u0561\u056f\u0561\u0576\u0561\u0581\u0580\u0565\u056c \u0567 \u0561\u057c\u0561\u057b\u056b\u0576 LASIK \u0568\u0576\u0569\u0561\u0581\u0561\u056f\u0561\u0580\u0563\u0565\u0580\u0568 \u0533\u0578\u0582\u0561\u0574\u0578\u0582\u0574, \u054d\u0561\u0575\u057a\u0561\u0576\u0578\u0582\u0574, \u054a\u0561\u056c\u0561\u0578\u0582\u0578\u0582\u0574 \u0587 \u0544\u0561\u0580\u0577\u0561\u056c\u0575\u0561\u0576 \u056f\u0572\u0566\u056b\u0576\u0565\u0580\u0578\u0582\u0574 \u2014 \u0562\u0565\u0580\u0565\u056c\u0578\u057e \u057f\u0565\u057d\u0578\u0572\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568 \u057e\u0565\u0580\u0561\u056f\u0561\u0576\u0563\u0576\u0578\u0572 \u057e\u056b\u0580\u0561\u0570\u0561\u057f\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568 \u053d\u0561\u0572\u0561\u0572 \u0585\u057e\u056f\u056b\u0561\u0576\u0578\u057d\u056b \u0570\u0565\u057c\u0561\u057e\u0578\u0580 \u0570\u0561\u0574\u0561\u0575\u0576\u0584\u0576\u0565\u0580\u056b\u0576:",
    "paragraph2": "\u0531\u0575\u057d\u0585\u0580, \u0576\u0578\u0582\u0575\u0576 \u0570\u0561\u0575\u057f\u0576\u0561\u0562\u0565\u0580\u0561\u056f\u0561\u0576 \u0578\u0563\u056b\u0576 \u0561\u057c\u0561\u057b\u0576\u0578\u0580\u0564\u0578\u0582\u0574 \u0567 \u0531\u057f\u0565\u056c\u0575\u0565\u056b \u0575\u0578\u0582\u0580\u0561\u0584\u0561\u0576\u0579\u0575\u0578\u0582\u0580 \u0568\u0576\u0569\u0561\u0581\u0561\u056f\u0561\u0580\u0563: \u0531\u057e\u0565\u056c\u056b \u0584\u0561\u0576 30,000 \u0570\u0561\u057b\u0578\u0572 \u057e\u056b\u0580\u0561\u0570\u0561\u057f\u0578\u0582\u0569\u0575\u0578\u0582\u0576: 99.2% \u0570\u056b\u057e\u0561\u0576\u0564\u0576\u0565\u0580\u056b \u0562\u0561\u057e\u0561\u0580\u0561\u0580\u057e\u0561\u056e\u0578\u0582\u0569\u0575\u0561\u0576 \u0574\u0561\u056f\u0561\u0580\u0564\u0561\u056f: \u054e\u0561\u0580\u057a\u0565\u057f\u056b \u0573\u0577\u057f\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568 \u056f\u056b\u0580\u0561\u057c\u057e\u0561\u056e \u057f\u0565\u057d\u0578\u0572\u0578\u0582\u0569\u0575\u0561\u0576 \u0576\u057e\u0565\u0580\u056b\u0576:",
    "readMore": "\u053f\u0561\u0580\u0564\u0561\u056c \u0561\u0574\u0562\u0578\u0572\u057b \u057a\u0561\u057f\u0574\u0578\u0582\u0569\u0575\u0578\u0582\u0576\u0568",
