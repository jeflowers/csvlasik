# Reduce deprecation warnings
audit-level=moderate
fund=false
progress=false
loglevel=warn

# Use newer package resolution
legacy-peer-deps=false
strict-peer-deps=false

# Network timeouts & retries (replace deprecated `timeout`)
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=60000

# Registry settings
registry=https://registry.npmjs.org/

# Cache settings (use prefer-online instead of deprecated cache-max)
prefer-online=true