# Reduce deprecation warnings
audit-level=moderate
fund=false
progress=false
loglevel=warn  # ← Add this to reduce warning noise

# Use newer package resolution
legacy-peer-deps=false
strict-peer-deps=false

# Timeout settings to prevent hanging
timeout=60000
fetch-timeout=60000

# Registry settings
registry=https://registry.npmjs.org/

# Cache settings (use prefer-online instead of deprecated cache-max)
prefer-online=true