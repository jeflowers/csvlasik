# Production Environment Variables
# Copy this file to .env.production and fill in your production values
# DO NOT commit .env.production to git!

# Node Environment
NODE_ENV=production

# Supabase Configuration (Production)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key-here

# Application URL
VITE_APP_URL=https://csvlasik.com

# Analytics (Optional - Add when Phase 10 is complete)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# API Configuration
VITE_API_TIMEOUT=30000

# Build Configuration
VITE_BUILD_TIME=__BUILD_TIME__
VITE_VERSION=1.0.0
