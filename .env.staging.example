# Staging Environment Variables
# Copy this file to .env.staging for staging deployments
# Use for testing before production

# Node Environment
NODE_ENV=staging

# Supabase Configuration (Staging)
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here

# Application URL
VITE_APP_URL=https://staging.csvlasik.com

# Analytics (Disabled for staging)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=true

# Debug Mode
VITE_DEBUG=true

# API Configuration
VITE_API_TIMEOUT=30000

# Build Configuration
VITE_BUILD_TIME=__BUILD_TIME__
VITE_VERSION=1.0.0-staging
